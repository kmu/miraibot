{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "pip_requirements": {
    "fileMatch": ["requirements.txt", "requirements-dev.txt"]
  }
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ],
  "platformAutomerge": true
}
